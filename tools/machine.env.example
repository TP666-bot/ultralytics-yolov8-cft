# Copy to tools/machine.env and edit WORKSPACE for your machine.
# Used by tools/setup_new_machine.sh

# Parent directory that contains ultralytics/ and (optionally) LLVIP/
WORKSPACE=/home/you/my_new_space

# Optional: override LLVIP root if not at $WORKSPACE/LLVIP or
# $WORKSPACE/multispectral-object-detection/LLVIP
# LLVIP_ROOT=/data/datasets/LLVIP
